generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  pending
  active
  inactive
  archived
}

enum FeeStatus {
  paid
  unpaid
}

model Shop {
  id           String     @id @default(uuid())
  shopNo       Int        @unique @default(autoincrement())
  shopName     String
  ownerName    String
  mobile       String     @unique
  email        String?
  cnic         String
  city         String
  address      String
  passwordHash String
  status       ShopStatus @default(pending)
  statusNote   String?
  monthlyFee   Int        @default(2500)

  profilePic      String? @db.Text
  docPhoto        String? @db.Text
  docCnicFront    String? @db.Text
  docCnicBack     String? @db.Text
  docShopDocument String? @db.Text

  feeRecords FeeRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shops")
}

model FeeRecord {
  id        String    @id @default(uuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  status    FeeStatus @default(unpaid)
  paidOn    DateTime?
  method    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shopId, month])
  @@map("fee_records")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}