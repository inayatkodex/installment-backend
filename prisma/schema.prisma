generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  pending
  active
  inactive
  archived
}

enum FeeStatus {
  paid
  unpaid
}

model Shop {
  id                     String      @id @default(uuid())
  shopNo                 Int         @unique @default(autoincrement())
  shopName               String
  ownerName              String
  mobile                 String      @unique
  email                  String?
  cnic                   String
  city                   String
  address                String
  passwordHash           String
  status                 ShopStatus  @default(pending)
  statusNote             String?
  pendingDeletionAt      DateTime?
  deletionPreviousStatus ShopStatus?
  tokenVersion           Int         @default(0)
  monthlyFee             Int         @default(0)
  customerSeq            Int         @default(0)

  profilePic      String? @db.Text
  docPhoto        String? @db.Text
  docCnicFront    String? @db.Text
  docCnicBack     String? @db.Text
  docShopDocument String? @db.Text

  feeRecords             FeeRecord[]
  feeRates               ShopFeeRate[]
  customers              Customer[]
  monthlyReportSnapshots MonthlyReportSnapshot[]
  refreshTokens          ShopRefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([pendingDeletionAt])
  @@map("shops")
}

model FeeRecord {
  id        String    @id @default(uuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  amount    Int       @default(0)
  status    FeeStatus @default(unpaid)
  paidOn    DateTime?
  method    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([shopId, month])
  @@index([month, status])
  @@map("fee_records")
}

model ShopFeeRate {
  id                 String   @id @default(uuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  amount             Int
  effectiveFromMonth String
  createdAt          DateTime @default(now())

  @@unique([shopId, effectiveFromMonth])
  @@index([effectiveFromMonth])
  @@map("shop_fee_rates")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

model ShopRefreshToken {
  id                String             @id @default(uuid())
  shopId            String
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash         String             @unique
  familyId          String
  tokenVersion      Int
  expiresAt         DateTime
  sessionExpiresAt  DateTime
  revokedAt         DateTime?
  replacedById      String?
  replacedBy        ShopRefreshToken?  @relation("ShopRefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces          ShopRefreshToken[] @relation("ShopRefreshRotation")
  refreshRetryUntil DateTime?
  deviceName        String?
  lastUsedAt        DateTime?
  createdAt         DateTime           @default(now())

  @@index([shopId, sessionExpiresAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("shop_refresh_tokens")
}

model Customer {
  id                      String    @id @default(uuid())
  shopId                  String
  shop                    Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerNo              Int
  name                    String
  fatherName              String?
  phone                   String
  cnic                    String?
  address                 String?
  photo                   String?   @db.Text
  docCnicFront            String?   @db.Text
  docCnicBack             String?   @db.Text
  docOther                String?   @db.Text
  downPayment             Int
  initialMonthlyPayment   Int
  monthlyPayment          Int
  monthlyCollectionTarget Int?
  firstDueDate            String // "YYYY-MM-DD"
  deletedAt               DateTime?
  deletionRequestedAt     DateTime?
  completedAt             DateTime?
  archivedAt              DateTime?
  filesPurgedAt           DateTime?

  items               CustomerItem[]
  payments            Payment[]
  rateChanges         CustomerRateChange[]
  scheduleDateChanges CustomerScheduleDateChange[]
  purchases           CustomerPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, customerNo])
  @@index([shopId, deletedAt])
  @@index([shopId, phone])
  @@index([deletionRequestedAt])
  @@index([archivedAt, completedAt])
  @@map("customers")
}

model MonthlyReportSnapshot {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  month     String
  data      Json
  createdAt DateTime @default(now())

  @@unique([shopId, month])
  @@index([month])
  @@map("monthly_report_snapshots")
}

model CustomerRateChange {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromInstallmentNo Int
  monthlyPayment    Int
  createdAt         DateTime @default(now())

  @@unique([customerId, fromInstallmentNo])
  @@index([customerId])
  @@map("customer_rate_changes")
}

model CustomerScheduleDateChange {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromInstallmentNo Int
  firstDueDate      String
  createdAt         DateTime @default(now())

  @@unique([customerId, fromInstallmentNo])
  @@index([customerId])
  @@map("customer_schedule_date_changes")
}

model CustomerPurchase {
  id                           String                               @id @default(uuid())
  customerId                   String
  customer                     Customer                             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  downPayment                  Int                                  @default(0)
  initialMonthlyPayment        Int
  monthlyPayment               Int
  firstDueDate                 String?
  allocationStartInstallmentNo Int
  items                        CustomerPurchaseItem[]
  rateChanges                  CustomerPurchaseRateChange[]
  scheduleDateChanges          CustomerPurchaseScheduleDateChange[]
  createdAt                    DateTime                             @default(now())

  @@index([customerId, createdAt])
  @@map("customer_purchases")
}

model CustomerPurchaseScheduleDateChange {
  id                String           @id @default(uuid())
  purchaseId        String
  purchase          CustomerPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  fromInstallmentNo Int
  firstDueDate      String
  createdAt         DateTime         @default(now())

  @@unique([purchaseId, fromInstallmentNo])
  @@index([purchaseId])
  @@map("customer_purchase_schedule_date_changes")
}

model CustomerPurchaseRateChange {
  id                String           @id @default(uuid())
  purchaseId        String
  purchase          CustomerPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  fromInstallmentNo Int
  monthlyPayment    Int
  createdAt         DateTime         @default(now())

  @@unique([purchaseId, fromInstallmentNo])
  @@index([purchaseId])
  @@map("customer_purchase_rate_changes")
}

model CustomerPurchaseItem {
  id         String           @id @default(uuid())
  purchaseId String
  purchase   CustomerPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  photo      String?          @db.Text
  boughtOn   String
  createdAt  DateTime         @default(now())

  @@index([purchaseId])
  @@map("customer_purchase_items")
}

model CustomerItem {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  photo      String?  @db.Text
  boughtOn   String // "YYYY-MM-DD"
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_items")
}

model Payment {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount         Int
  method         String    @default("Cash")
  note           String?
  idempotencyKey String?   @unique
  paidOn         DateTime  @default(now())
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([customerId, paidOn])
  @@index([paidOn, reversedAt])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String // "shop" | "admin" | "system"
  actorId    String
  action     String // Includes payment, shop status/fee/delete, and customer delete events
  entityType String // "Payment", "Shop", "FeeRecord", "Customer"
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
